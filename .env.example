# =============================================================================
# Freeboard Environment Reference (.env.example)
# =============================================================================
# Quick local start:
#   cp .env.dev .env
#
# This file documents all supported environment variables and defaults.
# - Variables in "Required for containerized non-development runtime" have no safe default.
# - "Advanced overrides" are optional and commented out with runtime defaults.
#
# API env precedence:
# 1) process env (shell/CI)
# 2) packages/api/.env (optional package-local override)
# 3) repo root .env
# 4) code defaults

# =============================================================================
# Required for containerized non-development runtime (must be defined)
# =============================================================================
# Used by docker-compose.yml / docker-compose.mongo.yml with strict checks.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_GATEWAY_SECRET=replace-with-a-long-random-gateway-secret-at-least-32-chars
GATEWAY_SERVICE_TOKEN=replace-with-a-long-random-gateway-service-token-at-least-32-chars
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Required when DB_BACKEND=mongo
FREEBOARD_MONGO_URL=mongodb://freeboard_app:replace-with-strong-app-password@freeboard-mongo:27017/freeboard
# Required when DB_BACKEND=postgres
# FREEBOARD_POSTGRES_URL=postgresql://postgres:replace-with-strong-password@freeboard-postgres:5432/freeboard
EGRESS_ALLOWED_HOSTS=api.open-meteo.com,api.coingecko.com
MONGO_INITDB_ROOT_USERNAME=replace-root-user
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-root-password
MONGO_APP_USERNAME=freeboard_app
MONGO_APP_PASSWORD=replace-with-strong-app-password

# =============================================================================
# Optional defaults (safe to leave unset unless you need to override)
# =============================================================================

# --- Core runtime ---
# NODE_ENV=development
# API_HOST=0.0.0.0
# HOST=0.0.0.0
# PORT defaults are service-specific:
# - API default: 4001
# - Gateway default: 8001
# Avoid setting shared root PORT unless intentionally overriding one process.
# PORT=4001

# --- API defaults ---
# DB_BACKEND=mongo
# MONGO_URL=mongodb://127.0.0.1:27017/freeboard
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/freeboard
# FREEBOARD_POSTGRES_URL=postgresql://postgres:postgres@freeboard-postgres:5432/freeboard
# POSTGRES_CONNECT_TIMEOUT_MS=30000
# POSTGRES_POOL_MAX_CONNECTIONS=10
# POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
# POSTGRES_SSL_MODE=disable
# JWT_TIME_EXPIRATION=2h
# USER_LIMIT=0
# CREATE_ADMIN=false
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Auth/role policy defaults ---
# AUTH_REGISTRATION_MODE=disabled
# AUTH_REGISTRATION_DEFAULT_ROLE=viewer
# AUTH_EDITOR_CAN_PUBLISH=false
# DASHBOARD_DEFAULT_VISIBILITY=private
# DASHBOARD_PUBLIC_LISTING_ENABLED=false
# EXECUTION_MODE=safe
# POLICY_EDIT_LOCK=false
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_WINDOW_SECONDS=300
# AUTH_LOGIN_LOCK_SECONDS=300
# Reverse-proxy trust hops for API client IP derivation (0 = trust socket only)
# API_TRUST_PROXY_HOPS=0
# Security limiter backend (`memory` fallback for local/dev only; non-dev should match DB_BACKEND)
# SECURITY_LIMITER_BACKEND=memory
# (`fail-open` default in development/test; `fail-closed` default in non-dev runtime)
# SECURITY_LIMITER_FAILURE_MODE=fail-open
# SECURITY_LIMITER_NAMESPACE=freeboard:security-limiter
# SECURITY_LIMITER_HASH_SALT=
# SECURITY_LIMITER_MONGO_TIMEOUT_MS=2500
# SECURITY_LIMITER_MEMORY_MAX_KEYS=10000

# --- Shared fetch/session controls (API + gateway) ---
# FETCH_TIMEOUT_MS=15000
# FETCH_MAX_RESPONSE_BYTES=5242880
# DATASOURCE_TOKEN_MINT_RATE_LIMIT_USER_PER_MIN=60
# DATASOURCE_TOKEN_MINT_RATE_LIMIT_PUBLIC_IP_PER_MIN=30
# DATASOURCE_TOKEN_MINT_RATE_LIMIT_SHARE_TOKEN_PER_MIN=60
# DATASOURCE_SESSION_TTL_SECONDS=300
# GATEWAY_INTROSPECTION_RATE_LIMIT_PER_MIN=600
# GATEWAY_REVOKED_TOKENS_RATE_LIMIT_PER_MIN=600
# GATEWAY_REVOKED_TOKENS_MAX_BATCH=500
# REALTIME_REVOKE_EVENT_RETENTION_SECONDS=86400

# --- Gateway egress + API link defaults ---
# EGRESS_ALLOWED_PORTS=80,443,1883,8883
# EGRESS_ALLOW_PRIVATE_DESTINATIONS=false
# EGRESS_ALLOW_INSECURE_TLS=false
# GATEWAY_API_BASE_URL=http://127.0.0.1:4001
# GATEWAY_INTROSPECTION_TIMEOUT_MS=5000
# GATEWAY_REVOKED_TOKENS_TIMEOUT_MS=5000
# GATEWAY_LIMITER_TIMEOUT_MS=3000
# GATEWAY_RUNTIME_METRICS_URL=http://127.0.0.1:8001/internal/metrics
# FREEBOARD_GATEWAY_RUNTIME_METRICS_URL=http://127.0.0.1:8001/internal/metrics
# GATEWAY_RUNTIME_METRICS_TIMEOUT_MS=2500

# --- Realtime policy defaults ---
# REALTIME_ENABLED=true
# REALTIME_MAX_CLIENT_CONNECTIONS_PER_IP=25
# REALTIME_MAX_CONNECTIONS_PER_DASHBOARD=1000
# REALTIME_MAX_SUBSCRIPTIONS_PER_CONNECTION=50
# REALTIME_CONNECT_TIMEOUT_MS=10000
# REALTIME_RECONNECT_MIN_MS=1000
# REALTIME_RECONNECT_MAX_MS=30000
# REALTIME_MAX_MESSAGE_BYTES=1048576
# REALTIME_CONNECT_RATE_LIMIT_IP_PER_MIN=60
# REALTIME_PUBLIC_SUBSCRIBE_RATE_LIMIT_IP_PER_MIN=60
# REALTIME_PUBLIC_SUBSCRIBE_RATE_LIMIT_SHARE_TOKEN_PER_MIN=120
# REALTIME_PUBLIC_REVALIDATE_INTERVAL_MS=30000
# REALTIME_PUBLIC_FULL_REVALIDATE_INTERVAL_MS=300000
# REALTIME_TRUST_PROXY_HOPS=0
# (`fail-open` default in development/test; use `fail-closed` in non-dev runtime)
# REALTIME_LIMITER_FAILURE_MODE=fail-open
#
# REALTIME_SSE_ENABLED=true
# REALTIME_SSE_IDLE_TIMEOUT_MS=120000
#
# REALTIME_WS_ENABLED=true
# REALTIME_WS_IDLE_TIMEOUT_MS=300000
# REALTIME_WS_PING_INTERVAL_MS=30000
#
# REALTIME_MQTT_ENABLED=true
# REALTIME_MQTT_MAX_MESSAGE_BYTES=262144
# REALTIME_MQTT_KEEPALIVE_SECONDS=60
# REALTIME_MQTT_ALLOWED_TOPICS=
# REALTIME_MQTT_MAX_QOS=1
# REALTIME_MQTT_MAX_CONNECTIONS_PER_BROKER=10
# REALTIME_MQTT_IDLE_DISCONNECT_MS=300000

# --- UI build/dev defaults ---
# FREEBOARD_API_HOST=127.0.0.1
# FREEBOARD_API_PORT=4001
# FREEBOARD_GATEWAY_HOST=127.0.0.1
# FREEBOARD_GATEWAY_PORT=8001
# FREEBOARD_STATIC=false
# FREEBOARD_BASE_PATH=/
# FREEBOARD_NODE_MODULES=./../../node_modules
# BASE_URL=/
# VITE_ALLOW_DIRECT_HTTP_DATASOURCE=false

# --- Docker compose defaults ---
# FREEBOARD_RUNTIME_ENV=production
# FREEBOARD_UI_IMAGE_TAG=latest
# FREEBOARD_API_IMAGE_TAG=latest
# FREEBOARD_GATEWAY_IMAGE_TAG=latest
# FREEBOARD_MONGO_IMAGE=mongo:7.0
# Raspberry Pi fallback override lives in .env.pi (see docs/manual/raspberry-pi-mongodb.md)
# MONGO_INITDB_DATABASE=freeboard
# MONGO_APP_DATABASE=freeboard

# --- Raspberry Pi player defaults ---
# FREEBOARD_PLAYER_URL=http://localhost:8080
# FREEBOARD_USER=<current-user>
# FREEBOARD_DISPLAY=:0.0
# FREEBOARD_BROWSER_BINARY=/usr/bin/chromium-browser
# FREEBOARD_BROWSER_FLAGS_EXTRA=
# FREEBOARD_URL_CHECK_MODE=head
# FREEBOARD_URL_CHECK_TIMEOUT_SECONDS=5
# FREEBOARD_URL_CHECK_INTERVAL_SECONDS=5
# FREEBOARD_URL_CHECK_MAX_ATTEMPTS=0
# FREEBOARD_DEFAULT_WIDTH=1920
# FREEBOARD_DEFAULT_HEIGHT=1080

# --- Advanced maintenance (manual operations only) ---
# Used by: npm run credentials:reencrypt
# CREDENTIAL_ENCRYPTION_KEY_NEW=<base64-encoded-32-byte-key>
