# ==============================================
# FREEBOARD ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and modify values as needed
# All variables show their default values when not set
# API env load order:
# 1) process env (shell/CI)
# 2) packages/api/.env (optional package-local override)
# 3) repo root .env
# 4) API defaults

# ==============================================
# API Configuration (packages/api)
# ==============================================

# MongoDB connection string
# Used by: packages/api/src/config.js
# Example only: replace credentials before non-local use.
MONGO_URL=mongodb://freeboard_app:replace-with-strong-db-password@127.0.0.1:27017/freeboard

# API server port
# Used by: packages/api/src/config.js
PORT=4001

# JWT authentication secret key
# Used by: packages/api/src/config.js
# Non-development deployments must set a strong value (>=32 chars)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# JWT token expiration time (e.g., "2h", "1d", "7d")
# Used by: packages/api/src/config.js
JWT_TIME_EXPIRATION=2h

# Maximum number of users allowed (0 = unlimited)
# Used by: packages/api/src/config.js
USER_LIMIT=0

# Default admin user email
# Used by: packages/api/src/config.js
# Must be valid email format: name@domain.ext
ADMIN_EMAIL=admin@example.local

# Default admin user password
# Used by: packages/api/src/config.js
# Must be >=12 chars and include uppercase, lowercase, number, and symbol
ADMIN_PASSWORD=ChangeMe123!

# Whether to create admin user on startup (true/false)
# Used by: packages/api/src/config.js
CREATE_ADMIN=false

# ==============================================
# Gateway Egress Configuration (packages/gateway)
# ==============================================

# Gateway server port
# Note: Uses same PORT variable as API - set per service if running separately
# Used by: packages/gateway/src/index.js
# PORT=8001
# EGRESS_ALLOWED_HOSTS=api.open-meteo.com,api.coingecko.com,*.example.com
# EGRESS_ALLOWED_PORTS=80,443,1883,8883
# EGRESS_ALLOW_PRIVATE_DESTINATIONS=false
# EGRESS_ALLOW_INSECURE_TLS=false
# FETCH_TIMEOUT_MS=15000
# FETCH_MAX_RESPONSE_BYTES=5242880
# GATEWAY_INTROSPECTION_TIMEOUT_MS=5000
# GATEWAY_API_BASE_URL=http://127.0.0.1:4001
# GATEWAY_REVOKED_TOKENS_TIMEOUT_MS=5000

# Datasource gateway signing key (shared between API and gateway)
JWT_GATEWAY_SECRET=replace-with-a-long-random-gateway-secret-at-least-32-chars

# Internal service-auth token used by gateway -> API introspection
GATEWAY_SERVICE_TOKEN=replace-with-a-long-random-gateway-service-token-at-least-32-chars

# Credential encryption key for API credential profiles (base64-encoded 32-byte key)
# Example generation: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Datasource token mint and introspection abuse controls
DATASOURCE_TOKEN_MINT_RATE_LIMIT_USER_PER_MIN=60
DATASOURCE_TOKEN_MINT_RATE_LIMIT_PUBLIC_IP_PER_MIN=30
DATASOURCE_TOKEN_MINT_RATE_LIMIT_SHARE_TOKEN_PER_MIN=60
DATASOURCE_SESSION_TTL_SECONDS=300
GATEWAY_INTROSPECTION_RATE_LIMIT_PER_MIN=600
GATEWAY_REVOKED_TOKENS_RATE_LIMIT_PER_MIN=600
GATEWAY_REVOKED_TOKENS_MAX_BATCH=500
REALTIME_REVOKE_EVENT_RETENTION_SECONDS=86400

# Gateway realtime policy controls
REALTIME_ENABLED=true
REALTIME_MAX_CLIENT_CONNECTIONS_PER_IP=25
REALTIME_MAX_CONNECTIONS_PER_DASHBOARD=1000
REALTIME_MAX_SUBSCRIPTIONS_PER_CONNECTION=50
REALTIME_CONNECT_TIMEOUT_MS=10000
REALTIME_RECONNECT_MIN_MS=1000
REALTIME_RECONNECT_MAX_MS=30000
REALTIME_MAX_MESSAGE_BYTES=1048576
REALTIME_CONNECT_RATE_LIMIT_IP_PER_MIN=60
REALTIME_PUBLIC_SUBSCRIBE_RATE_LIMIT_IP_PER_MIN=60
REALTIME_PUBLIC_SUBSCRIBE_RATE_LIMIT_SHARE_TOKEN_PER_MIN=120
REALTIME_PUBLIC_REVALIDATE_INTERVAL_MS=30000
REALTIME_PUBLIC_FULL_REVALIDATE_INTERVAL_MS=300000
REALTIME_TRUST_PROXY_HOPS=0

REALTIME_SSE_ENABLED=true
REALTIME_SSE_IDLE_TIMEOUT_MS=120000
REALTIME_WS_ENABLED=true
REALTIME_WS_IDLE_TIMEOUT_MS=300000
REALTIME_WS_PING_INTERVAL_MS=30000
REALTIME_MQTT_ENABLED=true
REALTIME_MQTT_MAX_MESSAGE_BYTES=262144
REALTIME_MQTT_KEEPALIVE_SECONDS=60
REALTIME_MQTT_ALLOWED_TOPICS=
REALTIME_MQTT_MAX_QOS=1
REALTIME_MQTT_MAX_CONNECTIONS_PER_BROKER=10
REALTIME_MQTT_IDLE_DISCONNECT_MS=300000

# ==============================================
# UI/Build Configuration (packages/ui)
# ==============================================

# Enable static build mode (for GitHub Pages deployment)
# Used by: packages/ui/vite.config.js
# FREEBOARD_STATIC=false

# Custom path to node_modules directory
# Used by: packages/ui/vite.config.js
# FREEBOARD_NODE_MODULES=./../../node_modules

# Package version (automatically set by npm)
# Used by: packages/ui/vite.config.js
# npm_package_version=1.2.0-dev

# Development host/port overrides for the UI->gateway dev proxy
# Used by: packages/ui/vite.config.js
# FREEBOARD_GATEWAY_HOST=127.0.0.1
# FREEBOARD_GATEWAY_PORT=8001

# Vite base URL for routing
# Used by: packages/ui/src/router/index.js
# BASE_URL=/

# Allow browser-direct HTTP datasource execution (development only recommended)
# Used by: packages/ui/src/datasources/HTTPDatasource.js
# VITE_ALLOW_DIRECT_HTTP_DATASOURCE=false

# ==============================================
# Auth/Role Policy Controls (packages/api)
# ==============================================
# Registration mode: disabled | invite | open
AUTH_REGISTRATION_MODE=disabled

# Default role for self-registration in open mode: viewer | editor
AUTH_REGISTRATION_DEFAULT_ROLE=viewer

# Whether editors can publish dashboards (true/false)
AUTH_EDITOR_CAN_PUBLISH=false

# Default visibility for new dashboards: private | link | public
DASHBOARD_DEFAULT_VISIBILITY=private

# Whether public dashboards are included in standard dashboard listings (true/false)
DASHBOARD_PUBLIC_LISTING_ENABLED=false

# Execution mode policy: safe | trusted
EXECUTION_MODE=safe

# Lock in-app policy mutation endpoints (true/false)
POLICY_EDIT_LOCK=false

# Login abuse controls
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_SECONDS=300

# ==============================================
# Docker Compose Configuration
# ==============================================

# Runtime mode for containerized API/gateway (`production` recommended)
# Used by: docker-compose.yml
FREEBOARD_RUNTIME_ENV=production

# MongoDB Docker image version
# Used by: docker-compose.mongo.yml
FREEBOARD_MONGO_IMAGE=mongo:7.0
# For Raspberry Pi 4, use:  (tested with unofficial image)
#FREEBOARD_MONGO_IMAGE=mongodb-raspberrypi4-unofficial-r7.0.4:latest

# MongoDB connection for containerized API
# Used by: docker-compose.yml
FREEBOARD_MONGO_URL=mongodb://freeboard_app:replace-with-strong-db-password@freeboard-mongo:27017/freeboard

# Containerized API uses `JWT_SECRET` defined above in API Configuration.

# Required for containerized gateway in production mode
# Comma-separated host allowlist (example values)
# Used by: docker-compose.yml -> packages/gateway/src/index.js
EGRESS_ALLOWED_HOSTS=api.open-meteo.com,api.coingecko.com

# MongoDB initialization (Docker internal)
# Used by: docker-compose.mongo.yml
MONGO_INITDB_ROOT_USERNAME=replace-root-user
MONGO_INITDB_ROOT_PASSWORD=replace-with-strong-root-password
MONGO_INITDB_DATABASE=freeboard
MONGO_APP_USERNAME=freeboard_app
MONGO_APP_PASSWORD=replace-with-strong-app-password
MONGO_APP_DATABASE=freeboard

# ==============================================
# Raspberry Pi Player Configuration
# ==============================================

# URL for the Raspberry Pi kiosk player
# Used by: player.sh
FREEBOARD_PLAYER_URL=http://localhost:8080

# ==============================================
# System/Development Configuration
# ==============================================

# User for Ansible deployment (automatically detected)
# Used by: ansible/playbook.yml
# USER=your-username

# Docker container ports (defined in Dockerfiles, not configurable via env)
# API: 4001, Gateway: 8001, UI: 80

# ==============================================
# Development Notes
# ==============================================

# For local development:
# 1. Copy this file to .env
# 2. Modify values as needed
# 3. For first-run local login bootstrap, set CREATE_ADMIN=true once and define
#    ADMIN_EMAIL / ADMIN_PASSWORD, then set CREATE_ADMIN=false after admin exists.
# 4. Run: npm run dev

# For Docker deployment:
# 1. Copy this file to .env
# 2. Modify FREEBOARD_* variables plus JWT_SECRET, JWT_GATEWAY_SECRET, GATEWAY_SERVICE_TOKEN, CREDENTIAL_ENCRYPTION_KEY, and EGRESS_ALLOWED_HOSTS
# 3. Run: docker compose up -d

# For static GitHub Pages build:
# 1. Set FREEBOARD_STATIC=true
# 2. Run: npm run build

# For Raspberry Pi kiosk:
# 1. Set FREEBOARD_PLAYER_URL to your dashboard URL
# 2. Set USER environment variable (usually auto-detected)
# 3. Run the ansible playbook

# Note: Local mongo data persists in the named Docker volume `freeboard-mongo-data`
# (preferred for Windows and Linux dev consistency).
