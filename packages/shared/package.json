{
  "name": "@freeboard/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./clientIp.js": {
      "types": "./src/clientIp.ts",
      "import": "./dist/clientIp.js"
    },
    "./runtimePolicy.js": {
      "types": "./src/runtimePolicy.ts",
      "import": "./dist/runtimePolicy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test --test-concurrency=1",
    "test:ci": "tsx --test --test-concurrency=1"
  }
}
