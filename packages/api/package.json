{
  "name": "@freeboard/api",
  "version": "0.1.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsc -p ../shared/tsconfig.build.json && tsx watch src/index.ts",
    "dev:raw": "tsx watch src/index.ts",
    "build": "tsc -p ../shared/tsconfig.build.json && tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/index.js",
    "test": "tsc -p ../shared/tsconfig.build.json && tsx --test --test-concurrency=1",
    "test:ci": "tsc -p ../shared/tsconfig.build.json && tsx --test --test-concurrency=1"
  },
  "private": true,
  "dependencies": {
    "@freeboard/shared": "0.1.0",
    "@graphql-tools/merge": "^9.0.12",
    "@graphql-tools/schema": "^10.0.9",
    "@graphql-tools/utils": "^11.0.0",
    "@graphql-yoga/logger": "^2.0.1",
    "@graphql-yoga/plugin-graphql-sse": "^3.18.1",
    "@whatwg-node/events": "^0.1.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "form-data": "^4.0.4",
    "graphql-subscriptions": "^3.0.0",
    "graphql-yoga": "^5.10.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.1",
    "mongoose": "^8.8.3",
    "nanoid": "^5.1.7",
    "uuid": "^13.0.0"
  }
}
