{
  "name": "freeboard",
  "title": "freeboard",
  "version": "2.0.0",
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": ">=11.10.0 <12"
  },
  "packageManager": "npm@11.10.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:services": "npm run build:shared && concurrently --kill-others --names \"ui,api,gateway\" --prefix \"[{name}]\" \"npm run dev:ui\" \"npm run dev:raw --workspace=packages/api\" \"npm run dev:raw --workspace=packages/gateway\"",
    "dev:mongo": "docker compose -f docker-compose.mongo.yml up --build",
    "dev:mongo:up": "docker compose -f docker-compose.mongo.yml up -d --build --wait --wait-timeout 180",
    "dev:mongo:status": "docker compose -f docker-compose.mongo.yml ps",
    "dev:mongo:logs": "docker compose -f docker-compose.mongo.yml logs --tail 200 -f mongo",
    "dev:mongo:down": "docker compose -f docker-compose.mongo.yml down --timeout 10",
    "dev:mongo:reset": "docker compose -f docker-compose.mongo.yml down -v --remove-orphans --timeout 10",
    "demo:realtime:up": "docker compose -f docker-compose.realtime-demo.yml up -d --build --wait --wait-timeout 180",
    "demo:realtime:down": "docker compose -f docker-compose.realtime-demo.yml down --timeout 10",
    "demo:realtime:smoke": "node scripts/realtime-demo-smoke.mjs",
    "test:realtime:integration": "node scripts/realtime-integration.mjs",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:gateway": "npm run dev --workspace=packages/gateway",
    "dev:ui": "npm run dev --workspace=packages/ui",
    "start:api": "npm run start --workspace=packages/api",
    "start:gateway": "npm run start --workspace=packages/gateway",
    "build:shared": "npm run build --workspace=@freeboard/shared",
    "build": "npm run build:all",
    "build:all": "npm run build:ui",
    "build:api": "npm run build --workspace=packages/api",
    "build:gateway": "npm run build --workspace=packages/gateway",
    "build:ui": "npm run build --workspace=packages/ui",
    "build:ui:metrics": "node scripts/ui-build-metrics.mjs",
    "build:ui:analyze": "npm run build:ui && npm run build:ui:metrics",
    "check:syntax": "node --check scripts/dev.mjs && node --check scripts/site-stage.mjs && node --check scripts/build-schema.mjs && node --check scripts/check-ui-theme-contrast.mjs && node --check scripts/check-ui-i18n-parity.mjs && node --check scripts/check-ui-i18n-composition-mode.mjs && node --check scripts/check-docs-manual-sidebar.mjs",
    "build:verify": "npm run build:ui && npm run build:api && npm run build:gateway && npm run check:ui:bundle-budget && npm run check:syntax",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ui": "eslint packages/ui/src --ext .ts,.vue",
    "lint:ui:fix": "eslint packages/ui/src --ext .ts,.vue --fix",
    "lint:api": "eslint packages/api/src --ext .ts",
    "lint:api:fix": "eslint packages/api/src --ext .ts --fix",
    "lint:gateway": "eslint packages/gateway/src --ext .ts",
    "lint:gateway:fix": "eslint packages/gateway/src --ext .ts --fix",
    "test": "npm run test:shared && npm run test:api && npm run test:ui && npm run test:gateway",
    "test:shared": "npm run test:ci --workspace=@freeboard/shared",
    "test:api": "npm run test:ci --workspace=packages/api",
    "test:ui": "npm run test:ci --workspace=packages/ui",
    "test:gateway": "npm run test:ci --workspace=packages/gateway",
    "test:e2e:smoke": "node scripts/e2e-smoke.mjs",
    "test:e2e": "playwright test --config playwright.e2e.config.mjs",
    "check:ui:store-boundaries": "node scripts/check-ui-store-boundaries.mjs",
    "check:ts:debt": "node scripts/check-ts-source-debt.mjs",
    "check:ts:source-artifacts": "node scripts/check-ts-source-artifacts.mjs",
    "check:runtime-deps": "node scripts/check-runtime-dependencies.mjs",
    "check:ui:theme-contrast": "node scripts/check-ui-theme-contrast.mjs",
    "check:ui:i18n-parity": "tsx scripts/check-ui-i18n-parity.mjs",
    "check:ui:i18n-composition-mode": "node scripts/check-ui-i18n-composition-mode.mjs",
    "check:ui:bundle-budget": "node scripts/check-ui-bundle-budget.mjs",
    "check:docs:manual-sidebar": "node scripts/check-docs-manual-sidebar.mjs",
    "typecheck:ui": "vue-tsc --noEmit -p packages/ui/tsconfig.json",
    "typecheck:shared": "tsc --noEmit -p packages/shared/tsconfig.json",
    "typecheck:gateway": "tsc --noEmit -p packages/gateway/tsconfig.json",
    "typecheck:api": "tsc --noEmit -p packages/api/tsconfig.json",
    "typecheck": "npm run typecheck:ui && npm run typecheck:shared && npm run typecheck:gateway && npm run typecheck:api",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit",
    "credentials:reencrypt": "tsx scripts/credentials-reencrypt.mjs",
    "dashboards:datasource:migrate-legacy-http": "tsx scripts/dashboards-datasource-migrate-legacy-http.mjs",
    "dashboards:visibility:migrate-legacy": "tsx scripts/dashboard-visibility-migrate-from-published.mjs",
    "dashboards:visibility:enforce-private": "tsx scripts/dashboard-visibility-enforce-private.mjs",
    "ci": "npm run format:check && npm run lint && npm run check:ui:store-boundaries && npm run check:ui:theme-contrast && npm run check:ui:i18n-parity && npm run check:ui:i18n-composition-mode && npm run check:docs:manual-sidebar && npm run check:ts:debt && npm run check:ts:source-artifacts && npm run check:runtime-deps && npm run test && npm run build:verify && npm run typecheck",
    "clean": "rimraf packages/ui/dist docs/.vitepress/dist docs/auto",
    "clean:deps": "rimraf node_modules packages/*/node_modules",
    "clean:all": "npm run clean && npm run clean:deps",
    "reinstall": "npm run clean:deps && npm install",
    "docs:generate:api": "rimraf docs/auto/api && typedoc --options typedoc.json",
    "docs:generate:graphql": "npm run build:shared && tsx scripts/build-schema.mjs",
    "docs:generate:vue": "vue-docgen -c docgen.config.js",
    "docs:generate": "npm run docs:generate:api && npm run docs:generate:graphql && npm run docs:generate:vue",
    "docs:verify": "npm run docs:generate && npm run site:stage",
    "site:stage": "node scripts/site-stage.mjs",
    "demo:build:local": "cross-env FREEBOARD_STATIC=1 FREEBOARD_BASE_PATH=/demo/ npm run build --workspace=packages/ui",
    "demo:build:pages": "cross-env FREEBOARD_STATIC=1 FREEBOARD_BASE_PATH=/freeboard/demo/ npm run build --workspace=packages/ui",
    "site:build:local": "cross-env SITE_BASE=/ vitepress build docs",
    "site:build:pages": "cross-env SITE_BASE=/freeboard/ vitepress build docs",
    "site:copy-demo": "shx mkdir -p docs/.vitepress/dist/demo && shx cp -r packages/ui/dist/* docs/.vitepress/dist/demo/",
    "site:local": "npm run docs:generate && npm run site:stage && npm run demo:build:local && npm run site:build:local && npm run site:copy-demo",
    "site:pages": "npm run docs:generate && npm run site:stage && npm run demo:build:pages && npm run site:build:pages && npm run site:copy-demo",
    "site:preview": "vitepress preview docs --port 8000"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@playwright/test": "^1.54.2",
    "prettier": "^3.6.2",
    "globals": "^17.4.0",
    "rimraf": "^6.0.1",
    "shx": "^0.4.0",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "@types/node": "^24.3.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.1",
    "vitepress": "^1.6.4",
    "vue-tsc": "^2.2.12",
    "vue-docgen-cli": "^4.79.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.59.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "workspaces": [
    "packages/ui",
    "packages/api",
    "packages/gateway",
    "packages/shared"
  ]
}
