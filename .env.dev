# Freeboard local development environment (minimal + complete)
# Usage:
#   cp .env.dev .env
#   npm run dev
#
# MUST/SHOULD change markers:
# - [MUST_CHANGE_NONLOCAL] change before any shared/staging/prod use
# - [SHOULD_CHANGE_LOCAL] recommended even for local multi-user/shared machines

NODE_ENV=development

# -------------------------------------------------------------------
# Mongo bootstrap for docker-compose.mongo.yml (required for npm run dev)
# -------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=freeboard_root
# [SHOULD_CHANGE_LOCAL]
MONGO_INITDB_ROOT_PASSWORD=freeboard_root_local_dev_pw
MONGO_INITDB_DATABASE=freeboard
MONGO_APP_USERNAME=freeboard_app
# [SHOULD_CHANGE_LOCAL]
MONGO_APP_PASSWORD=freeboard_app_local_dev_pw
MONGO_APP_DATABASE=freeboard

# API local Mongo connection (must match app user/password above)
MONGO_URL=mongodb://freeboard_app:freeboard_app_local_dev_pw@127.0.0.1:27017/freeboard

# -------------------------------------------------------------------
# Auth/bootstrap (required for first local login bootstrap)
# -------------------------------------------------------------------
# [MUST_CHANGE_NONLOCAL]
JWT_SECRET=freeboard-local-dev-jwt-secret-0123456789
# [MUST_CHANGE_NONLOCAL]
JWT_GATEWAY_SECRET=freeboard-local-dev-gateway-secret-0123456789
# [MUST_CHANGE_NONLOCAL]
GATEWAY_SERVICE_TOKEN=freeboard-local-dev-gateway-service-token-0123456789

# Base64-encoded 32-byte key (keeps credential profiles readable across restarts)
# Local deterministic key for quick start:
CREDENTIAL_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Keep true for first local bootstrap, then set false after admin is created.
CREATE_ADMIN=true
# [SHOULD_CHANGE_LOCAL]
ADMIN_EMAIL=admin@example.local
# [MUST_CHANGE_NONLOCAL]
ADMIN_PASSWORD=LocalDevAdmin123!
